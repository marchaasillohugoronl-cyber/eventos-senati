# Neon PostgreSQL (usar la cadena "pooled" para DATABASE_URL y la directa para DIRECT_URL)
DATABASE_URL=
DIRECT_URL=

# Auth.js (generar con: npx auth secret  /  openssl rand -base64 32)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# Sesión del panel administrativo (mínimo 32 caracteres aleatorios)
ADMIN_SESSION_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Tiempo real (Ably). ABLY_API_KEY solo en el servidor.
ABLY_API_KEY=

# Opcional: clave para /tv?key=... (si se define, la TV la exige)
TV_ACCESS_KEY=

# Dominio real de producción, sin barra final. Ej: https://eventshare-senati.vercel.app
NEXT_PUBLIC_APP_URL=

# Datos para el seed del primer administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
